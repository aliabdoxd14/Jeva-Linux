  <name>Jeva</name>
  <summary>A refined media client for Jellyfin, Emby and Plex</summary>

  <description>
    <p>
      Jeva is a customizable media client for Jellyfin, Emby and Plex, designed
      to make browsing and enjoying your personal media library feel like a
      modern streaming service.
    </p>
    <ul>
      <li>Modern, streaming-inspired interface</li>
      <li>Customizable themes and layouts</li>
      <li>Personalized home screen</li>
      <li>Movie and TV show library browsing</li>
      <li>Media filtering and sorting</li>
      <li>Multiple interface languages</li>
    </ul>
  </description>

  <launchable type="desktop-id">Jeva.desktop</launchable>

