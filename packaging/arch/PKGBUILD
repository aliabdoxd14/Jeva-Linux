# Maintainer: aliabdoxd14 <https://github.com/aliabdoxd14>
# Based on the upstream Jeva project by Min Kim <https://github.com/tearerry/Jeva>
pkgname=jeva
pkgver=1.0.2
pkgrel=1
pkgdesc="A refined media client for Jellyfin, Emby and Plex"
arch=('x86_64')
url="https://github.com/aliabdoxd14/Jeva-Linux"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3')
optdepends=(
  'libappindicator-gtk3: tray icon support'
  'alsa-lib: audio output'
  'libpulse: audio output'
)
provides=('jeva')
conflicts=()
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

# The upstream project publishes only a closed-source Windows installer, so
# this package is built from the Linux port in the Jeva-Linux repository.
# `upstream-dist/` (the web UI) is generated by `npm run sync` and is embedded
# into the binary at compile time.
build() {
    cd "$srcdir/$pkgname-$pkgver"

    export CARGO_HOME="${CARGO_HOME:-$srcdir/.cargo-home}"
    # Reuse an existing target directory when one is provided, so a local
    # rebuild does not have to recompile the whole dependency tree.
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/$pkgname-$pkgver/target}"

    # The web UI must be present before `cargo build`: tauri-build embeds it.
    if [ ! -d upstream-dist ]; then
        echo "error: upstream-dist/ is missing — run 'npm run sync' first" >&2
        return 1
    fi

    cargo build --release --features custom-protocol --offline \
        || cargo build --release --features custom-protocol

    install -Dm755 "target/release/jeva" "$pkgdir/usr/bin/jeva"

    install -Dm644 "packaging/linux/Jeva.desktop" \
        "$pkgdir/usr/share/applications/Jeva.desktop"
    install -Dm644 "packaging/linux/app.jeva.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/app.jeva.metainfo.xml"

    # The icon names must match the `Icon=jeva` key in the desktop entry.
    for size in 16 32 48 64 128 256; do
        install -Dm644 "src-tauri/icons/${size}x${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/jeva.png" 2>/dev/null || true
    done
    install -Dm644 "src-tauri/icons/128x128@2x.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/jeva.png"
    install -Dm644 "src-tauri/icons/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/jeva.png"
}
